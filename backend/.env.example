# Environment Variables for StockPilot Backend
# Copy this file to .env for local running: cp .env.example .env

# Database connection URL (PostgreSQL)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://stockpilot_user:stockpilot_pass@localhost:5432/stockpilot_db

# Application Configuration
APP_ENV=development
APP_NAME=StockPilot
APP_PORT=8000
DEBUG=True

# Prometheus Metrics Settings
METRICS_ENABLED=True
